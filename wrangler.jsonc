{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Static-assets-only Worker: there is no `main` script because this site is
  // pure static output. Cloudflare serves ./dist directly from its edge.
  //
  // Cloudflare now steers new Git-connected projects into Workers rather than
  // Pages, so this replaces a Pages project. The build output is unchanged and
  // stays portable — see README § Deployment.
  "name": "samuelecorra-portfolio",
  "compatibility_date": "2026-09-01",

  "assets": {
    "directory": "./dist",

    // First-class SPA fallback: unmatched paths such as /projects/ironmath or
    // /knowledge/anno2-crittografia return index.html with a 200 instead of a
    // 404, so client-side routes resolve on a hard refresh or a shared link.
    //
    // Do NOT also ship a public/_redirects with `/* /index.html 200`. Workers
    // static assets validates that file and normalises /index.html to /, so
    // the rule resolves to itself and the deploy is rejected as an infinite
    // loop. This setting is the correct mechanism here; _redirects is only
    // needed on hosts that have no equivalent (see README § Deployment).
    "not_found_handling": "single-page-application",
  },

  "observability": {
    "enabled": true,
  },
}
